#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <220>; };

&mt { quick_tap_ms = <220>; };

/ {
};

/ {
    behaviors {
        homerowL: homerowL {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROWL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <13 14 15 16 36 37 38>;
            hold-trigger-on-release;
        };

        homerowR: homerowR {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROWR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <39 40 41 22 21 20 19>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
        };

        abreFechaP: abreFechaP {
            compatible = "zmk,behavior-tap-dance";
            label = "ABREFECHAP";
            #binding-cells = <0>;
            tapping-term-ms = <160>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        abreFechaCh: abreFechaCh {
            compatible = "zmk,behavior-tap-dance";
            label = "ABREFECHACH";
            #binding-cells = <0>;
            tapping-term-ms = <160>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        abreFechaCo: abreFechaCo {
            compatible = "zmk,behavior-tap-dance";
            label = "ABREFECHACO";
            #binding-cells = <0>;
            tapping-term-ms = <160>;
            bindings = <&kp LS(LEFT_BRACKET)>, <&kp LS(RIGHT_BRACKET)>;
        };

        paren: paren {
            compatible = "zmk,behavior-hold-tap";
            label = "PAREN";
            bindings = <&parens>, <&abreFechaP>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        colches: colches {
            compatible = "zmk,behavior-hold-tap";
            label = "COLCHES";
            bindings = <&colche>, <&abreFechaCo>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        chave: chave {
            compatible = "zmk,behavior-hold-tap";
            label = "CHAVE";
            bindings = <&chaves>, <&abreFechaCh>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <3 14>;
            require-prior-idle-ms = <100>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <3 16>;
            require-prior-idle-ms = <100>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 15>;
            require-prior-idle-ms = <100>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <15 16>;
            require-prior-idle-ms = <100>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <26 27>;
            require-prior-idle-ms = <100>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <2 3>;
            require-prior-idle-ms = <100>;
        };

        all {
            bindings = <&kp LC(A)>;
            key-positions = <2 1>;
            require-prior-idle-ms = <100>;
        };

        eh {
            bindings = <&eh>;
            key-positions = <21 31>;
            require-prior-idle-ms = <100>;
        };

        ah {
            bindings = <&ah>;
            key-positions = <31 20>;
            require-prior-idle-ms = <100>;
        };

        ih {
            bindings = <&ih>;
            key-positions = <31 22>;
            require-prior-idle-ms = <100>;
        };

        oh {
            bindings = <&oh>;
            key-positions = <31 8>;
            require-prior-idle-ms = <100>;
        };

        ch {
            bindings = <&ch>;
            key-positions = <27 38>;
            require-prior-idle-ms = <100>;
        };

        ao {
            bindings = <&ao>;
            key-positions = <20 8>;
            require-prior-idle-ms = <100>;
        };

        an {
            bindings = <&an>;
            key-positions = <20 19>;
            require-prior-idle-ms = <100>;
        };

        c_paren {
            bindings = <&paren 0 0>;
            key-positions = <8 9>;
            require-prior-idle-ms = <100>;
        };

        c_chaves {
            bindings = <&chave 0 0>;
            key-positions = <20 21>;
            require-prior-idle-ms = <100>;
        };

        c_colche {
            bindings = <&colches 0 0>;
            key-positions = <33 32>;
            require-prior-idle-ms = <100>;
        };
    };

    macros {
        eh: eh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp E>;
            label = "EH";
        };

        ah: ah {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp A>;
            label = "AH";
        };

        oh: oh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp O>;
            label = "OH";
        };

        ih: ih {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp I>;
            label = "IH";
        };

        ch: ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp C>;
            label = "CH";
        };

        ao: ao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp A &kp O>;
            label = "AO";
        };

        an: an {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp A>;
            label = "AN";
        };

        parens: parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "PARENS";
        };

        chaves: chaves {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "CHAVES";
        };

        colche: colche {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET) &kp LEFT>;
            label = "COLCHE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        romak {
            // ------------------------------------------------------------------------------------------------
            //| LGUI/] |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | RGUI/[ | 
            //| CTRL/` |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | CTRL/' |
            //| LALT/\ |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | RALT/- |
            //                             | RSE | SPC | LWR |   | LWR | BKSP | RSE |

            bindings = <
&kp TAB          &kp Q                 &kp B                 &kp M                     &kp G                   &kp K          &kp X      &kp L                    &kp O                      &kp U                  &kp Y                  &kp DELETE
&mt LCTRL GRAVE  &homerowL LEFT_GUI D  &homerowL LEFT_ALT N  &homerowL LEFT_CONTROL S  &homerowL LEFT_SHIFT T  &kp W          &kp Z      &homerowR RIGHT_SHIFT R  &homerowR RIGHT_CONTROL A  &homerowR RIGHT_ALT E  &homerowR RIGHT_GUI I  &mt RIGHT_ALT SQT
&kp LEFT_SHIFT   &kp SLASH             &kp F                 &kp C                     &kp P                   &kp V          &kp J      &kp H                    &kp COMMA                  &kp DOT                &kp SEMICOLON          &kp ENTER
                                                             &mo 4                     &mo 1                   &kp BACKSPACE  &kp SPACE  &mo 3                    &mo 2
            >;
        };

        ESP {
            // -----------------------------------------------------------------------------------------
            //|LGUI/CAPS |  *  |  7 |  8  |  9  |  +  |    |  !  |  @  |  #  |  $  |  %  | RGUI/F1 |
            //|CTRL/MENU |  /  |  4 |  5  |  6  |  -  |    |  ^  |  &  |  *  |  (  |  )  | CTRL/F2 |
            //|  LALT/=  |  0  |  1 |  4  |  3  |  .  |    |  ls |  F4 |  F5 |  F6 |  F7 | RALT/F3 |
            //                      | ADJ | ___ | ___ |    | ___ | ___ | ADJ |

            bindings = <
&kp ESCAPE  &kp EXCL   &kp AT_SIGN   &kp HASH        &kp DOLLAR  &kp PERCENT  &none   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none  &trans
&trans      &kp CARET  &kp ASTERISK  &kp MINUS       &kp PLUS    &kp SQT      &none   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &none  &trans
&trans      &kp N0     &kp N1        &kp UNDERSCORE  &kp EQUAL   &none        &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none  &trans
                                     &bootloader     &trans      &trans       &trans  &kp NUMBER_0  &trans
            >;
        };

        arrow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans          &kp UP_ARROW    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                        &trans  &trans  &trans  &trans  &bootloader  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans              &trans              &trans               &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&sk LEFT_ALT        &kp LG(UP_ARROW)    &swapper             &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                             &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
