#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define ROMAK 0
#define ESP 1
#define ARROW 2
#define FUNC 3

#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

&lt { quick_tap_ms = <220>; };

&mt { quick_tap_ms = <220>; };

/ {
};

/ {
    behaviors {
        homerowL: homerowL {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROWL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        homerowR: homerowR {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROWR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
        };

        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
        };

        abreFechaP: abreFechaP {
            compatible = "zmk,behavior-tap-dance";
            label = "ABREFECHAP";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;

            tapping-term-ms = <285>;
        };

        abreFechaCh: abreFechaCh {
            compatible = "zmk,behavior-tap-dance";
            label = "ABREFECHACH";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        abreFechaCo: abreFechaCo {
            compatible = "zmk,behavior-tap-dance";
            label = "ABREFECHACO";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET)>, <&kp LS(RIGHT_BRACKET)>;
        };

        paren: paren {
            compatible = "zmk,behavior-hold-tap";
            label = "PAREN";
            bindings = <&parens>, <&abreFechaP>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
        };

        colches: colches {
            compatible = "zmk,behavior-hold-tap";
            label = "COLCHES";
            bindings = <&colche>, <&abreFechaCo>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
        };

        chave: chave {
            compatible = "zmk,behavior-hold-tap";
            label = "CHAVE";
            bindings = <&chaves>, <&abreFechaCh>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
        };

        aspasSimples: aspasSimples {
            compatible = "zmk,behavior-hold-tap";
            label = "ASPASSIMPLES";
            bindings = <&aspas>, <&aspS>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        aspasDuplas: aspasDuplas {
            compatible = "zmk,behavior-hold-tap";
            label = "ASPASDUPLAS";
            bindings = <&aspasD>, <&aspD>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        abreFechaAba: abreFechaAba {
            compatible = "zmk,behavior-tap-dance";
            label = "ABREFECHAABA";
            #binding-cells = <0>;
            bindings = <&kp LC(T)>, <&kp LC(W)>;

            tapping-term-ms = <300>;
        };
    };

    combos {
        compatible = "zmk,combos";

        copy {
            bindings = <&kp LC(C)>;
            layers = <ROMAK>;
            key-positions = <3 14 38>;
            require-prior-idle-ms = <100>;
        };

        paste {
            bindings = <&kp LC(V)>;
            layers = <ROMAK>;
            key-positions = <3 16 38>;
            require-prior-idle-ms = <100>;
        };

        find {
            bindings = <&kp LC(F)>;
            layers = <ROMAK>;
            key-positions = <26 3 16 38>;
            require-prior-idle-ms = <100>;
        };

        tab {
            bindings = <&kp TAB>;
            layers = <ROMAK>;
            key-positions = <14 15 16>;
            require-prior-idle-ms = <100>;
        };

        enter {
            bindings = <&kp ENTER>;
            layers = <ROMAK>;
            key-positions = <15 16 38>;
            require-prior-idle-ms = <100>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            layers = <ROMAK>;
            key-positions = <26 27 38>;
            require-prior-idle-ms = <100>;
        };

        cut {
            bindings = <&kp LC(X)>;
            layers = <ROMAK>;
            key-positions = <2 3 4 38>;
            require-prior-idle-ms = <100>;
        };

        all {
            bindings = <&kp LC(A)>;
            layers = <ROMAK>;
            key-positions = <2 1 38>;
            require-prior-idle-ms = <100>;
        };

        eh {
            bindings = <&eh>;
            layers = <ROMAK>;
            key-positions = <21 31>;
            require-prior-idle-ms = <100>;
        };

        ah {
            bindings = <&ah>;
            layers = <ROMAK>;
            key-positions = <31 20>;
            require-prior-idle-ms = <100>;
        };

        ih {
            bindings = <&ih>;
            layers = <ROMAK>;
            key-positions = <31 22>;
            require-prior-idle-ms = <100>;
        };

        oh {
            bindings = <&oh>;
            layers = <ROMAK>;
            key-positions = <31 8>;
            require-prior-idle-ms = <100>;
        };

        ch {
            bindings = <&ch>;
            layers = <ROMAK>;
            key-positions = <27 38>;
            require-prior-idle-ms = <100>;
        };

        ao {
            bindings = <&ao>;
            layers = <ROMAK>;
            key-positions = <20 8>;
            require-prior-idle-ms = <100>;
        };

        an {
            bindings = <&an>;
            layers = <ROMAK>;
            key-positions = <20 19>;
            require-prior-idle-ms = <100>;
        };

        c_paren {
            bindings = <&paren 0 0>;
            layers = <ROMAK>;
            key-positions = <21 20 39>;
            require-prior-idle-ms = <100>;
        };

        c_chaves {
            bindings = <&chave 0 0>;
            layers = <ROMAK>;
            key-positions = <8 9 39>;
            require-prior-idle-ms = <100>;
        };

        c_colche {
            bindings = <&colches 0 0>;
            layers = <ROMAK>;
            key-positions = <32 33 39>;
            require-prior-idle-ms = <100>;
        };

        aspas_C {
            bindings = <&aspasSimples 0 0>;
            layers = <ROMAK>;
            key-positions = <3 2 38>;
            require-prior-idle-ms = <100>;
        };

        aspasD_C {
            bindings = <&aspasDuplas 0 0>;
            layers = <ROMAK>;
            key-positions = <38 14 15>;
            require-prior-idle-ms = <100>;
        };

        int {
            bindings = <&kp LS(SLASH)>;
            layers = <ROMAK>;
            key-positions = <13 14 38>;
            require-prior-idle-ms = <100>;
        };

        PontVirg {
            bindings = <&kp SEMICOLON>;
            layers = <ROMAK>;
            key-positions = <22 21>;
            require-prior-idle-ms = <100>;
        };

        oes {
            bindings = <&oes>;
            layers = <ROMAK>;
            key-positions = <8 21>;
            require-prior-idle-ms = <100>;
        };

        ea {
            bindings = <&ea>;
            layers = <ROMAK>;
            key-positions = <21 20>;
            require-prior-idle-ms = <100>;
        };

        s_enter {
            bindings = <&kp LS(ENTER)>;
            layers = <ROMAK>;
            key-positions = <15 16 14 38>;
            require-prior-idle-ms = <100>;
        };

        uh {
            bindings = <&uh>;
            layers = <ROMAK>;
            key-positions = <31 9>;
            require-prior-idle-ms = <100>;
        };
    };

    macros {
        eh: eh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp E>;
            label = "EH";
        };

        ah: ah {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp A>;
            label = "AH";
        };

        oh: oh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp O>;
            label = "OH";
        };

        ih: ih {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp I>;
            label = "IH";
        };

        ch: ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp C>;
            label = "CH";
        };

        ao: ao {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp A &kp O>;
            label = "AO";
        };

        an: an {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp A>;
            label = "AN";
        };

        parens: parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "PARENS";
        };

        chaves: chaves {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "CHAVES";
        };

        colche: colche {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET) &kp LEFT>;
            label = "COLCHE";
        };

        aspas: aspas {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE &kp SPACE &kp SINGLE_QUOTE &kp SPACE &kp LEFT>;
            label = "ASPAS";
        };

        aspasD: aspasD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SINGLE_QUOTE) &kp SPACE &kp LS(SINGLE_QUOTE) &kp SPACE &kp LEFT>;
            label = "ASPASD";
        };

        aspS: aspS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE &kp SPACE>;
            label = "ASPS";
        };

        aspD: aspD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SINGLE_QUOTE) &kp SPACE>;
            label = "ASPD";
        };

        select: select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp E &kp L &kp E &kp C &kp T &kp SPACE &kp STAR &kp SPACE &kp F &kp R &kp O &kp M>;
            label = "SELECT";
        };

        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp O &kp U &kp V &kp E &kp I &kp A &kp V &kp I &kp N &kp I &kp C &kp I &kp U &kp S &kp N9 &kp N6 &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "EMAIL";
        };

        consinco: consinco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp O &kp N &kp S &kp I &kp N &kp C &kp O &kp TAB &kp C &kp O &kp N &kp S &kp I &kp N &kp C &kp O>;
            label = "CONSINCO";
        };

        oes: oes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TILDE &kp O &kp E &kp S>;
            label = "OES";
        };

        ea: ea {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp E>;
            label = "EA";
        };

        uh: uh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp U>;
            label = "UH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        romak {
            display-name = "ROMAK";
            // ------------------------------------------------------------------------------------------------
            //| LGUI/] |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | RGUI/[ | 
            //| CTRL/` |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | CTRL/' |
            //| LALT/\ |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | RALT/- |
            //                             | RSE | SPC | LWR |   | LWR | BKSP | RSE |

            bindings = <
&kp ESCAPE    &kp Q                 &kp B                 &kp M                     &kp G                   &kp K          &kp X      &kp L                    &kp O                      &kp U                  &kp Y                  &kp DELETE
&kp TAB       &homerowL LEFT_GUI D  &homerowL LEFT_ALT N  &homerowL LEFT_CONTROL S  &homerowL LEFT_SHIFT T  &kp W          &kp Z      &homerowR RIGHT_SHIFT R  &homerowR RIGHT_CONTROL A  &homerowR RIGHT_ALT E  &homerowR RIGHT_GUI I  &mt RIGHT_ALT SQT
&kp CAPSLOCK  &kp SLASH             &kp F                 &kp C                     &kp P                   &kp V          &kp J      &kp H                    &kp COMMA                  &kp DOT                &kp SEMICOLON          &kp ENTER
                                                          &mo FUNC                  &mo ESP                  &kp BACKSPACE  &kp SPACE  &kp LEFT_SHIFT           &mo ARROW
            >;
        };

        esp {
            display-name = "SYM";
            // -----------------------------------------------------------------------------------------
            //|LGUI/CAPS |  *  |  7 |  8  |  9  |  +  |    |  !  |  @  |  #  |  $  |  %  | RGUI/F1 |
            //|CTRL/MENU |  /  |  4 |  5  |  6  |  -  |    |  ^  |  &  |  *  |  (  |  )  | CTRL/F2 |
            //|  LALT/=  |  0  |  1 |  4  |  3  |  .  |    |  ls |  F4 |  F5 |  F6 |  F7 | RALT/F3 |
            //                      | ADJ | ___ | ___ |    | ___ | ___ | ADJ |

            bindings = <
&kp ESCAPE   &kp EXCL   &kp AT_SIGN   &kp HASH        &kp DOLLAR  &kp PERCENT  &select    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS      &kp MINUS
&kp LC(F12)  &kp CARET  &kp ASTERISK  &kp MINUS       &kp PLUS    &kp SQT      &email     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp SLASH
&trans       &kp N0     &kp N1        &kp UNDERSCORE  &kp EQUAL   &kp GRAVE    &consinco  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COMMA     &kp PERIOD
                                      &bootloader     &trans      &trans       &trans     &kp NUMBER_0  &trans
            >;
        };

        arrow {
            display-name = "NAV";
            bindings = <
&trans  &trans  &trans  &kp LA(F4)        &kp LA(F10)     &trans        &trans  &trans       &trans  &kp LC(LS(TAB))  &abreFechaAba   &kp LC(TAB)
&trans  &trans  &trans  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans        &trans  &trans       &trans  &kp HOME         &kp UP_ARROW    &kp END
&trans  &trans  &trans  &trans            &trans          &trans        &trans  &trans       &trans  &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW
                        &trans            &kp CAPSLOCK    &kp LEFT_GUI  &trans  &bootloader  &trans
            >;
        };

        func {
            display-name = "FUNC";
            bindings = <
&kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMLOCK  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F12  &kp F13
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F14  &kp F15
                              &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
